# --- Trading mode: paper (default). "live" requires Phase 4 gates (see README). ---
TRADING_MODE=paper

# --- Alpaca PAPER credentials (https://app.alpaca.markets, paper dashboard) ---
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=your-paper-secret-here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Alpaca LIVE credentials (Phase 4 only; leave unset to make live mode impossible) ---
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=
# MAX_LIVE_EQUITY_USD=

# --- Persistence (unset DATABASE_URL -> SQLite fallback at ./lobplatform.db) ---
# DATABASE_URL=postgresql+psycopg2://lob:lob@localhost:5432/lob
DB_BACKEND=sqlite

# --- Pub-sub (unset -> in-process asyncio fallback) ---
# REDIS_URL=redis://localhost:6379/0

# --- API auth ---
APP_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# --- CORS (comma-separated; add your Railway web service URL) ---
# CORS_ORIGINS=https://your-web-service.railway.app,http://localhost:3000

# --- Engine ---
RISK_TIER=medium
LOB_FLOW_ARCH=tcn
